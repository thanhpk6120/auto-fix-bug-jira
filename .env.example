# --- JIRA CONFIG (Cô lập theo project) ---
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=KANBAN

# --- PROJECT DIRECTORY CONFIG ---
# Cấu hình thư mục làm việc của dự án, hỗ trợ đa dự án trong một repo
# SERVICES_DIR=services (Project 1, cổng 8080/5173) hoặc SERVICES_DIR=services-2 (Project 2, cổng 8081/5174)
SERVICES_DIR=services

# (Lưu ý: Sentry DSN được cấu hình độc lập cho từng service trong services.json và application.properties/.env của từng service con)

# --- GITHUB / GIT CONFIG (Cô lập theo project, không dùng tài khoản chung của máy) ---
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_REPO=username/repository-name
# Luồng nhánh mới DEV->TARGET->PROD:
# - GIT_DEV_BRANCH: nhánh DEV để tách worktree fix bug (vd: develop, dev)
GIT_DEV_BRANCH=develop
# - GIT_TARGET_BRANCH: nhánh TARGET để deploy dev/demo, verify sau fix (vd: pre-prod, staging, dev)
GIT_TARGET_BRANCH=pre-prod
# - GIT_PROD_BRANCH: nhánh PROD quan trọng - Chỉ tạo PR lên nhánh này sau khi đã verify thành công, không push trực tiếp
GIT_PROD_BRANCH=main
# DEPRECATED fallback: GIT_BASE_BRANCH (dùng khi GIT_DEV_BRANCH trống), GIT_PREPROD_BRANCH (dùng khi GIT_TARGET_BRANCH trống). Ưu tiên dùng 3 biến mới ở trên.
GIT_BASE_BRANCH=main
GIT_PREPROD_BRANCH=pre-prod
GIT_AUTHOR_NAME=AI-Bug-Fixer
GIT_AUTHOR_EMAIL=ai-bot@local.dev

# --- HEALTH CHECK CONFIG (DEPRECATED: ưu tiên services.json) ---
# DEPRECATED: PREPROD_HEALTH_URL - Ưu tiên khai báo deployUrl + healthPath từng service trong services.json
PREPROD_HEALTH_URL=http://dev-demo.local/actuator/health

# --- CLAUDE CONFIG ---
CLAUDE_MODEL=claude-3-7-sonnet
# Giới hạn thời gian chạy tối đa cho mỗi bug (ms). Quá hạn sẽ tự kill để ngắt chi phí.
CLAUDE_TIMEOUT_MS=300000

# --- TELEGRAM CONFIG ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890
# Danh sách Telegram User ID có quyền duyệt (lấy ID tại bot @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
