# --- JIRA CONFIG ---
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_TOKEN=your-jira-api-token

# --- CONCURRENCY CONFIG ---
# Số lượng job AI chạy song song đồng thời bởi worker.js (mặc định: 2)
MAX_CONCURRENT_JOBS=2

# --- GIT HOST CONFIG (Hỗ trợ GitHub mặc định hoặc Git tự host của doanh nghiệp) ---
# Điền domain của server git (mặc định: github.com)
# Ví dụ doanh nghiệp: git.cybertech.vn
GIT_HOST=github.com
# Token xác thực (ưu tiên dùng thay vì GITHUB_TOKEN cũ)
GIT_TOKEN=ghp_yourPersonalAccessTokenHere
# Tùy chọn: Đường dẫn gọi API tạo MR/PR tự động nếu dùng GitLab/Gitea. Để trống sẽ yêu cầu tạo thủ công.
# Ví dụ GitLab: https://git.cybertech.vn/api/v4/projects/{repo}/merge_requests
# GIT_API_BASE_URL=

# --- GITHUB CONFIG (CŨ) ---
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# --- CLAUDE CONFIG ---
CLAUDE_MODEL=claude-3-7-sonnet
# Giới hạn thời gian chạy tối đa cho mỗi bug (ms). Quá hạn sẽ tự kill để ngắt chi phí.
CLAUDE_TIMEOUT_MS=300000

# --- TELEGRAM CONFIG ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890
# Danh sách Telegram User ID có quyền duyệt (lấy ID tại bot @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
